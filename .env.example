# ---------- AI ----------
# Free keys. Groq (https://console.groq.com/keys) is tried first, Gemini (https://aistudio.google.com/apikey) is the backup.
# Text job posts are read WITHOUT AI; AI is only used to tailor the CV for real sends and to read image posters.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional: order of provider:model to try
# AI_CHAIN=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,gemini:gemini-2.5-flash-lite

# ---------- WhatsApp ----------
# Exact group name(s) as shown in WhatsApp, comma-separated
WHATSAPP_GROUPS=
# Send a summary of every action to your own "Message yourself" chat
NOTIFY_SELF=true

# ---------- Gmail ----------
# Needs 2-Step Verification ON, then create an App Password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---------- Rules ----------
# true = do everything (score, tailor, make PDF, notify) but don't send. Set false to go live.
DRY_RUN=true
MIN_SCORE=70
MAX_APPLICATIONS_PER_DAY=12
EXPERIENCE_TOLERANCE_YEARS=1
REAPPLY_AFTER_DAYS=30
MIN_SEND_DELAY_SEC=45
MAX_SEND_DELAY_SEC=180
